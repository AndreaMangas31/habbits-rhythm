# Key restricted to translations:read and this app's allowed origins.
NEXT_PUBLIC_LANGUAGER_API_KEY=lan_client_replace_me

# Optional: defaults to https://api.languager.ai/v1
# NEXT_PUBLIC_LANGUAGER_API_URL=https://api.languager.ai/v1
# Server equivalent. Set this when the API URL is not the production default.
# LANGUAGER_BASE_URL=https://api.languager.ai/v1

# Server-only key with translations:create. Never prefix this with NEXT_PUBLIC_.
LANGUAGER_API_KEY=lan_server_replace_me
